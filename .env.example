# RentKeepers Configuration Example
# ================================
# Copy this to .env and fill in your actual values

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///rentkeepers.db

# Email Configuration (use Mailtrap for testing)
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_DEFAULT_SENDER=rentkeepers@example.com

# Stripe (optional - for payments)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# Crypto Wallets (optional - for crypto payments)
BTC_WALLET=your_btc_address
ETH_WALLET=your_eth_address
USDC_WALLET=your_usdc_address
